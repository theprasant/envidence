{
  "name": "envidence",
  "version": "1.0.1",
  "author": {
    "name": "Prasant",
    "url": "https://envidence.prasant.dev/",
    "email": "developer.prasant@gmail.com"
  },
  "description": "Snapshot the machine layer Git ignores, find out what changed when a command fails, and review a reversible plan.",
  "homepage": "https://envidence.prasant.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theprasant/envidence.git"
  },
  "bugs": {
    "url": "https://github.com/theprasant/envidence/issues"
  },
  "keywords": [
    "environment",
    "snapshot",
    "reproducibility",
    "debugging",
    "developer-tools",
    "local-first",
    "windows",
    "cli",
    "diff",
    "rollback"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "envidence": "dist/cli.js",
    "evd": "dist/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "docs/DEMO.md",
    "docs/LIMITATIONS.md",
    "docs/PRIVACY.md",
    "docs/SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && vite build -c vite.ui.config.ts",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:ui": "vite build -c vite.ui.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "release:check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check",
    "demo": "npm run build && node dist/cli.js demo"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
